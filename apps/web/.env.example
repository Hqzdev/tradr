# Скопировать в .env.local (Next.js подхватывает его автоматически, файл
# в .gitignore по умолчанию в next-проектах — проверь, что так и есть).

# URL бэкенда. Локально — Spring Boot на 8080, в проде — домен на Railway/
# Render/VPS (не Vercel — бэкенд там не живёт, см. backend/docs/00-overview.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# WebSocket-эндпоинт бэкенда (котировки, живые решения агентов, симуляции).
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080/ws
