# Скопировать в .env и заполнить перед первым запуском.
# .env должен быть в .gitignore — не коммитить реальные секреты.

# --- База данных (совпадает с docker-compose.dev.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/tradr
DB_USER=tradr
DB_PASSWORD=tradr_dev_password

# --- Auth / JWT ---
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- Рыночные данные ---
# synthetic — детерминированный генератор на бэкенде (как сейчас на фронте, useTicker.ts)
# finnhub   — реальные котировки через Finnhub (см. docs/03-market-data-and-agents-engine.md)
MARKET_DATA_PROVIDER=synthetic
FINNHUB_API_KEY=

# --- CORS: домен фронта (локально и на Vercel) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://<your-vercel-app>.vercel.app
